{
  "name": "pos",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "pnpm --filter @pos/app dev",
    "build": "pnpm -r --if-present run build",
    "preview": "pnpm --filter @pos/app preview",
    "typecheck": "pnpm -r --if-present run typecheck",
    "lint": "eslint . && pnpm --filter @pos/app run check:tokens",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,ts,vue,json,md}\" --ignore-path .gitignore",
    "test": "pnpm -r --if-present run test",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.63.0",
    "@tsconfig/node20": "^20.1.10",
    "@types/node": "^22.20.1",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^9.33.0",
    "fast-check": "^4.9.0",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^3.2.7",
    "vue-tsc": "^2.2.12"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@parcel/watcher",
      "better-sqlite3",
      "workerd"
    ]
  }
}
