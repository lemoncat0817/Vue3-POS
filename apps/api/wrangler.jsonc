{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "maji-tea-pos-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      // 這兩個值需要在實際建立 D1 資料庫後填入（見 apps/api/README.md）：
      //   wrangler d1 create maji-tea-pos-db
      // 指令會印出 database_id，貼回這裡。database_name 可以自訂，
      // 不需要跟這裡的值一致，只是本機識別用。
      "database_name": "maji-tea-pos-db",
      "database_id": "REPLACE_AFTER_WRANGLER_D1_CREATE"
    }
  ]
}
